# Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ──────────────────────────────────────────────────
# Get this from MongoDB Atlas: Clusters → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mentorlink?retryWrites=true&w=majority

# ─── Authentication ────────────────────────────────────────────
# Use a long random string — e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173
